{
  "name": "driftor",
  "version": "1.0.0",
  "private": true,
  "description": "A real-browser gate for AI-written UI changes: Kane CLI catches clicks that never land, a coding agent fixes them, Kane re-verifies.",
  "license": "Apache-2.0",
  "author": "mrnetwork",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "vitest run",
    "driftor": "node driftor.js",
    "driftor:gate": "node driftor.js gate",
    "driftor:test": "node driftor_test.js",
    "driftor:inject": "node driftor.js --inject",
    "driftor:zoo": "node driftor.js --list",
    "driftor:heal": "node driftor.js --heal",
    "driftor:reset": "node driftor.js --reset",
    "driftor:watch": "node driftor.js --watch",
    "driftor:preflight": "node scripts/preflight.js",
    "agent": "DRIFTOR_HOOK=1 claude",
    "kane:login": "kane-cli login --oauth",
    "kane:balance": "kane-cli balance"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "14.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testmuai/kane-cli": "^0.10.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.17",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
