+/** Removes one key. Returns null when no key has that id, so the route can 404. */
+export function revokeKey(state: CloudScaleState, keyId: string, now = new Date()): CloudScaleState | null {
+  const key = state.keys.find((k) => k.id === keyId);
+  if (!key) return null;
+  return {
+    ...state,
+    keys: state.keys.filter((k) => k.id !== keyId),
+    status: "KEY_REVOKED",
+    updatedAt: now.toISOString(),
+    activity: log(state, { at: now.toISOString(), kind: "key.revoked", message: `${key.id} “${key.name}” revoked` }),
+  };
+}
