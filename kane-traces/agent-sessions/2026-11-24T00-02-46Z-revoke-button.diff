diff --git a/app/api/cloudscale/keys/revoke/route.ts b/app/api/cloudscale/keys/revoke/route.ts
new file mode 100644
index 0000000..15d3ff1
--- /dev/null
+++ b/app/api/cloudscale/keys/revoke/route.ts
@@ -0,0 +1,16 @@
+import { NextResponse } from "next/server";
+import { revokeKey } from "@/lib/cloudscale";
+import { load, runIdFrom, save } from "@/lib/cloudscale-store";
+
+export const dynamic = "force-dynamic";
+
+/** Revokes the key named by `{ keyId }`. An id that isn't in the workspace changes nothing. */
+export async function POST(request: Request) {
+  const id = runIdFrom(request);
+  if ("error" in id) return NextResponse.json({ error: id.error }, { status: 400 });
+  const { keyId } = (await request.json().catch(() => ({}))) as { keyId?: string };
+  if (!keyId) return NextResponse.json({ error: "keyId is required" }, { status: 400 });
+  const state = revokeKey(load(id.run), keyId);
+  if (!state) return NextResponse.json({ error: `unknown key ${keyId}` }, { status: 404 });
+  return NextResponse.json(save(state, id.run));
+}
