+/**
+ * Removes one key. Revoking is permanent: the key leaves the list, so the
+ * Active keys count drops by one. Unknown ids leave the state untouched.
+ */
+export function revokeKey(state: CloudScaleState, id: string, now = new Date()): CloudScaleState {
+  const key = state.keys.find((k) => k.id === id);
+  if (!key) return state;
+  return {
+    ...state,
+    keys: state.keys.filter((k) => k.id !== id),
+    updatedAt: now.toISOString(),
+    activity: log(state, {
+      at: now.toISOString(),
+      kind: "key.revoked",
+      message: `${key.id} “${key.name}” revoked`,
+    }),
+  };
+}
