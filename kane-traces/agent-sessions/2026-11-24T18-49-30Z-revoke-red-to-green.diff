diff --git a/app/api/cloudscale/keys/[id]/route.ts b/app/api/cloudscale/keys/[id]/route.ts
new file mode 100644
index 0000000..d10dcce
--- /dev/null
+++ b/app/api/cloudscale/keys/[id]/route.ts
@@ -0,0 +1,15 @@
+import { NextResponse } from "next/server";
+import { revokeKey } from "@/lib/cloudscale";
+import { load, runIdFrom, save } from "@/lib/cloudscale-store";
+
+export const dynamic = "force-dynamic";
+
+/** Revokes one key. Returns 404 when the id isn't in the workspace. */
+export async function DELETE(request: Request, { params }: { params: { id: string } }) {
+  const id = runIdFrom(request);
+  if ("error" in id) return NextResponse.json({ error: id.error }, { status: 400 });
+  const state = load(id.run);
+  const next = revokeKey(state, params.id);
+  if (next === state) return NextResponse.json({ error: `no such key: ${params.id}` }, { status: 404 });
+  return NextResponse.json(save(next, id.run));
+}
diff --git a/tests/unit/revoke.test.tsx b/tests/unit/revoke.test.tsx
new file mode 100644
index 0000000..4a243f9
--- /dev/null
+++ b/tests/unit/revoke.test.tsx
@@ -0,0 +1,97 @@
+/**
+ * Revoking a key: the domain transition, and the dashboard's Revoke button.
+ *
+ * As with cloudscale.test.tsx, JSDOM never hit-tests, so these say nothing
+ * about whether the button is actually clickable on a real narrow screen —
+ * that is Kane's job. They cover the state change and the wiring.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { generateKey, revokeKey, seedState, type CloudScaleState } from "@/lib/cloudscale";
+import CloudScaleDashboard from "@/app/app/CloudScaleDashboard";
+
+vi.mock("canvas-confetti", () => ({ default: () => undefined }));
+vi.mock("next/link", () => ({
+  default: ({ href, children, ...rest }: { href: string; children: React.ReactNode }) => (
+    <a href={href} {...rest}>
+      {children}
+    </a>
+  ),
+}));
+
+let server: CloudScaleState;
+function fakeApi(input: RequestInfo | URL, init?: RequestInit) {
+  const url = String(input);
+  const method = init?.method ?? "GET";
+  let body: unknown;
+  if (url === "/api/cloudscale" && method === "GET") body = server;
+  else if (url === "/api/cloudscale/keys" && method === "POST") {
+    const res = generateKey(server);
+    server = res.state;
+    body = res;
+  } else if (url.startsWith("/api/cloudscale/keys/") && method === "DELETE") {
+    const id = decodeURIComponent(url.slice("/api/cloudscale/keys/".length));
+    const next = revokeKey(server, id);
+    if (next === server) return Promise.resolve(new Response("not found", { status: 404 }));
+    body = server = next;
+  } else return Promise.resolve(new Response("not found", { status: 404 }));
+  return Promise.resolve(new Response(JSON.stringify(body), { status: 200 }));
+}
+
+beforeEach(() => {
+  server = seedState();
+  vi.stubGlobal("fetch", vi.fn(fakeApi));
+});
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+describe("revokeKey", () => {
+  it("drops the key and logs it", () => {
+    const next = revokeKey(seedState(), "KEY-001");
+    expect(next.keys.map((k) => k.id)).toEqual(["KEY-002"]);
+    expect(next.activity[0]).toMatchObject({ kind: "key.revoked" });
+    expect(next.activity[0].message).toContain("KEY-001");
+  });
+
+  it("leaves the state untouched for an unknown id", () => {
+    const state = seedState();
+    expect(revokeKey(state, "KEY-404")).toBe(state);
+  });
+
+  it("never reuses the id of a revoked key", () => {
+    const afterRevoke = revokeKey(seedState(), "KEY-001");
+    const { state } = generateKey(afterRevoke);
+    expect(state.keys.map((k) => k.id)).toEqual(["KEY-003", "KEY-002"]);
+  });
+});
+
+describe("Revoke button (JSDOM)", () => {
+  it("each seeded key has one", async () => {
+    render(<CloudScaleDashboard />);
+    await screen.findByText("2 Keys");
+    expect(screen.getByTestId("revoke-btn-KEY-001")).toBeTruthy();
+    expect(screen.getByTestId("revoke-btn-KEY-002")).toBeTruthy();
+    expect(screen.getAllByRole("button", { name: /^Revoke KEY-/ })).toHaveLength(2);
+  });
+
+  it("removes that key from the list and lowers Active keys by one", async () => {
+    render(<CloudScaleDashboard />);
+    await screen.findByText("2 Keys");
+    fireEvent.click(screen.getByTestId("revoke-btn-KEY-001"));
+    expect(await screen.findByText("1 Keys")).toBeTruthy();
+    expect(screen.queryByText("KEY-001")).toBeNull();
+    expect(screen.getByText("KEY-002")).toBeTruthy();
+  });
+
+  it("revoking every key empties the list", async () => {
+    render(<CloudScaleDashboard />);
+    await screen.findByText("2 Keys");
+    fireEvent.click(screen.getByTestId("revoke-btn-KEY-002"));
+    await screen.findByText("1 Keys");
+    fireEvent.click(screen.getByTestId("revoke-btn-KEY-001"));
+    expect(await screen.findByText("0 Keys")).toBeTruthy();
+    expect(screen.getByText(/No active keys/)).toBeTruthy();
+  });
+});
